# Postgres. Use a pooled URL on serverless hosts; DIRECT/SHADOW URLs are for migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/india_uncharted"
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/india_uncharted_shadow"

# ≥32 random bytes: openssl rand -base64 48
JWT_SECRET=""

# Public origin, no trailing slash
NEXT_PUBLIC_SITE_URL="https://indiauncharted.com"

# Set on a client preview only: any username, this password, basic auth on every page.
# Leave empty on the live domain.
PREVIEW_PASSWORD=""

# Only "true" in production. Anything else serves Disallow: / and noindex.
SITE_INDEXABLE="false"

# local | cloudinary
MEDIA_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# log | smtp
EMAIL_PROVIDER="log"
SMTP_URL=""
EMAIL_FROM=""
EMAIL_TO_ENQUIRIES=""

# First SUPER_ADMIN created by `npm run db:seed`
SEED_SUPERADMIN_EMAIL=""
SEED_SUPERADMIN_PASSWORD=""

# Optional spam protection
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""
