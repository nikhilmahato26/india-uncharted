{
  "name": "india-uncharted",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:studio": "prisma studio",
    "wp:fetch": "tsx scripts/import-wordpress/fetch.ts",
    "wp:import": "tsx --conditions=react-server scripts/import-wordpress/import.ts",
    "postinstall": "prisma generate",
    "check:redirects": "node scripts/check-redirects.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "check:all": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
