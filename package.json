    "@tiptap/starter-kit": "^3.31.3",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.13",
    "lucide-react": "^1.46.0",
    "motion": "^13.3.0",
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
